{
  "name": "real-fake-birds",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next build && next dev",
    "ios": "CAPACITOR_SERVER_URL=http://localhost:3000 npx cap sync ios && npx cap open ios",
    "android": "CAPACITOR_SERVER_URL=http://10.0.2.2:3000 npx cap sync android && npx cap open android",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "seed": "npx tsx scripts/seed-cdn.ts --skip-existing",
    "seed:failed": "npx tsx scripts/seed-cdn.ts --only-failed --skip-existing",
    "seed:force": "npx tsx scripts/seed-cdn.ts",
    "seed:fake": "npx tsx scripts/seed-cdn.ts --fake --skip-existing",
    "seed:fake:force": "npx tsx scripts/seed-cdn.ts --fake",
    "seed:fake:multi-sample": "npx tsx scripts/seed-cdn.ts --fake --multi-only --sample 10",
    "seed:fake:from-samples": "npx tsx scripts/seed-cdn.ts --fake --from-samples",
    "generate:fake": "npx tsx scripts/generate-fake-birds.ts",
    "generate:fake:seed": "npx tsx scripts/generate-fake-birds.ts --seed",
    "prune:fake": "npx tsx scripts/prune-fake-birds.ts",
    "prune:fake:apply": "npx tsx scripts/prune-fake-birds.ts --apply",
    "validate:fake": "npx tsx scripts/validate-fake-birds.ts",
    "validate:fake:moderate": "npx tsx scripts/validate-fake-birds.ts --moderate-text",
    "validate:fake:moderate:images": "npx tsx scripts/validate-fake-birds.ts --moderate-text --moderate-images",
    "backfill:sciname": "npx tsx scripts/backfill-cdn-sciname.ts",
    "backfill:sciname:dry-run": "npx tsx scripts/backfill-cdn-sciname.ts --dry-run",
    "migrate": "SUPABASE_PROJECT_REF=pyizgeecjvbxgbjwpcjj supabase db push",
    "migrate:prod": "SUPABASE_PROJECT_REF=bbmuqhogdpadbirwllrw supabase db push"
  },
  "dependencies": {
    "@capacitor-community/native-audio": "^8.0.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/browser": "^8.0.3",
    "@capacitor/core": "^8.3.1",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/splash-screen": "^8.0.1",
    "@marsidev/react-turnstile": "^1.5.0",
    "@supabase/ssr": "^0.10.0",
    "@supabase/supabase-js": "^2.101.1",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "bad-words": "^4.0.0",
    "canvas-confetti": "^1.9.4",
    "framer-motion": "^12.38.0",
    "lucide-react": "^1.7.0",
    "next": "16.2.1",
    "posthog-js": "^1.364.7",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1030.0",
    "@capacitor/android": "^8.3.1",
    "@capacitor/cli": "^8.3.1",
    "@capacitor/ios": "^8.3.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "^4.1.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "jsdom": "^29.0.1",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.3",
    "vitest": "^4.1.2"
